# Copy to .env and fill in. .env is never committed.
#
# Two OpenAI-compatible endpoints: the GENERATOR drafts, the FALSIFIER checks. They should be
# different model families, so the falsifier is not grading its own family's output.

# public = AMD tokenfactory (the public demo); local = the Somnus box over Tailscale (on-prem story)
AP_MODE=public

# AMD tokenfactory (notebooks.amd.com/tokenfactory). An endpoint whose base URL starts with
# TOKENFACTORY_BASE_URL gets TOKENFACTORY_API_KEY unless it has its own <ROLE>_API_KEY.
TOKENFACTORY_BASE_URL=
TOKENFACTORY_API_KEY=

# Public mode: both from the tokenfactory list, different families.
GENERATOR_BASE_URL=
GENERATOR_MODEL=
FALSIFIER_BASE_URL=
FALSIFIER_MODEL=

# Local mode example (Somnus box, tailnet only, llama-server has no key):
# GENERATOR_BASE_URL=http://somnus:8091/v1
# GENERATOR_MODEL=Qwen3.5-35B-A3B-Q4_K_M.gguf
# GENERATOR_THINKING_PARAM=true
# FALSIFIER_BASE_URL=http://somnus:<port>/v1
# FALSIFIER_MODEL=gemma-3-12b-it-Q4_K_M.gguf
# FALSIFIER_THINKING_PARAM=false
